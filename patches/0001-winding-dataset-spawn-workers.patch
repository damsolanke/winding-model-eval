@@ -134,6 +134,12 @@ class VolumeSlabExtractor:
         transform[:3, 3] = -inverse_linear @ values[:, 3] / target_downscale
         return transform
 
+    def __getstate__(self):
+        # Volume handles are per process (see _volume) and not picklable.
+        state = self.__dict__.copy()
+        state["_volume_handles"] = {}
+        return state
+
     def _volume(self, volume_idx: int) -> vc.Volume:
         # DataLoader workers must not inherit another process's cache and I/O
         # thread pool, so handles are deliberately opened lazily per process.
diff --git a/vesuvius/src/vesuvius/neural_tracing/winding_models/winding_model_dataset.py b/vesuvius/src/vesuvius/neural_tracing/winding_models/winding_model_dataset.py
