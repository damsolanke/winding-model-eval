+++ b/vesuvius/src/vesuvius/neural_tracing/winding_models/winding_model_dataset.py
@@ -57,6 +57,19 @@ class Segment:
     block_min: np.ndarray
     block_max: np.ndarray
 
+    # GridRaycaster is a nanobind object and cannot be pickled, which "spawn"
+    # DataLoader workers need (macOS); rebuild it from the grid on unpickle.
+    def __getstate__(self):
+        state = self.__dict__.copy()
+        state["raycaster"] = self.raycaster is not None
+        return state
+
+    def __setstate__(self, state):
+        rebuild = bool(state["raycaster"])
+        self.__dict__.update(state, raycaster=None)
+        if rebuild:
+            self.raycaster = GridRaycaster(self.xyz, self.valid_quads)
